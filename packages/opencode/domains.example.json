{
  "domains": [
    {
      "name": "Frontend",
      "jira_components": ["frontend", "ui"],
      "jira_labels": ["area/frontend"],
      "repo_globs": ["*frontend*", "*web-ui*"],
      "owner": "frontend-team"
    },
    {
      "name": "Backend",
      "jira_components": ["backend", "api"],
      "jira_labels": ["area/backend"],
      "repo_globs": ["*backend*", "*api-server*"],
      "owner": "backend-team"
    },
    {
      "name": "Infrastructure",
      "jira_components": ["infra", "deployment"],
      "jira_labels": ["area/infra"],
      "repo_globs": ["*infra*", "*deploy*"],
      "owner": "infra-team"
    }
  ]
}
